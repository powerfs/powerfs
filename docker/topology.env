# =============================================================================
# Legacy Docker 拓扑单一来源（证书夹具）
#
# scripts/generate-certs.sh 与本目录下的 cert 夹具（certs-default/）读取本文件。
# 修改节点 IP 时只改这里，然后重新生成证书：
#   scripts/generate-certs.sh --topology three
#
# P2 已完成：主 compose 不再手工维护，由 powerfs-ctl config render 从
# cluster.toml 生成。本文件与 cluster.toml 的 IP 必须保持一致，否则
# master 的证书 SAN 校验会拒绝连接。CI 的 check-topology-sync.sh 已保障
# 两者同步。
# =============================================================================

SUBNET="172.30.0.0/16"
GATEWAY="172.30.0.1"
REDIS_IP="172.30.0.50"
# 辅助服务（非 HA 主路径）
MONITOR_IP="172.30.0.30"
S3_IP="172.30.0.40"

# master admin API（证书签发入口）
MASTER_API_HOST="172.30.0.11"
MASTER_API_PORT="9300"

# 三节点 HA（bridge 172.30.0.x）
THREE_MASTER_IPS=(172.30.0.11 172.30.0.12 172.30.0.13)
THREE_FILER_IDS=(filer-1 filer-2 filer-3)
THREE_FILER_IPS=(172.30.0.31 172.30.0.32 172.30.0.33)
THREE_VOLUME_IDS=(volume-1 volume-2 volume-3 volume-4 volume-5 volume-6)
THREE_VOLUME_IPS=(172.30.0.21 172.30.0.22 172.30.0.23 172.30.0.24 172.30.0.25 172.30.0.26)
THREE_FUSE_IDS=(fuse-client-1 fuse-client-2)
THREE_FUSE_IPS=(172.30.0.41 172.30.0.42)

# host RDMA 拓扑：所有存储节点共享 host IP
HOST_NODE_IP="192.168.100.3"
# VM kernel-client 源 IP（ib0 IPoIB 优先，eth0 docker-net 兜底）
HOST_VM1_IPS=(192.168.100.51 172.30.0.100)
HOST_VM2_IPS=(192.168.100.52 172.30.0.101)
