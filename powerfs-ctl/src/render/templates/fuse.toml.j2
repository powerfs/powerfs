# Rendered by powerfs-ctl for fuse client. DO NOT EDIT.
[global]
log_level = "info"
redis_url = "{{ redis_url }}"

[fuse]
mount_point = "/mnt/powerfs"
master_addresses = [{% for ip in master_net_addrs %}"{{ ip }}"{% if not loop.last %}, {% endif %}{% endfor %}]
master_net_port = 9334
volume_net_port = 8901
filer_net_port = 9334
collection = "default"
replication = "000"
threads = 8
verbose = {{ verbose | lower }}
container = {{ container | lower }}
{% if log_file is defined %}log_file = "{{ log_file }}"
{% endif %}
{% if force_mount %}
force_mount = true
# Fallback when master topology has no healthy filer shards yet.
filer_addresses = [{% for ip in filer_ips %}"{{ ip }}"{% if not loop.last %}, {% endif %}{% endfor %}]
volume_addresses = [{% for ip in volume_ips %}"{{ ip }}"{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}
request_timeout_secs = {{ request_timeout_secs }}
{% if admin_port is defined %}admin_port = {{ admin_port }}
{% endif %}
[fuse.lease]
mode = "cap"
lease_duration_ms = 30000
renew_interval_ms = 10000
